# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional. Verify model ids at https://openrouter.ai/models
F1_DEFAULT_MODEL=anthropic/claude-sonnet-4.6
F1_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-4.1-mini,google/gemini-2.5-flash
